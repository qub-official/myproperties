{
  "name": "myproperties",
  "productName": "MyProperties",
  "version": "1.0.0",
  "description": "A calm little toolkit for Windows: folder tree & sizes, full PC specs, video to audio, animated wallpapers and themes.",
  "main": "src/main/main.js",
  "author": "MyProperties contributors",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/qub-official/myproperties",
  "repository": {
    "type": "git",
    "url": "https://github.com/qub-official/myproperties.git"
  },
  "keywords": [
    "windows",
    "disk-usage",
    "folder-tree",
    "system-information",
    "video-to-audio",
    "ffmpeg",
    "live-wallpaper",
    "animated-wallpaper",
    "themes",
    "electron"
  ],
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/make-icon.js",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "koffi": "^2.16.4",
    "pretendard": "^1.3.9",
    "systeminformation": "^5.33.24"
  },
  "devDependencies": {
    "electron": "^44.11.5",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.myproperties.app",
    "productName": "MyProperties",
    "copyright": "MIT License",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/koffi/build/koffi/{darwin_*,freebsd_*,linux_*,musl_*,openbsd_*,win32_ia32,win32_arm64}/**",
      "!node_modules/koffi/{src,vendor,doc}/**",
      "!node_modules/pretendard/dist/{public,web/static}/**",
      "!node_modules/pretendard/dist/web/variable/woff/**",
      "!node_modules/**/*.{md,map,ts}"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/koffi/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MyProperties",
      "artifactName": "MyProperties-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "MyProperties-Portable-${version}.exe"
    }
  }
}
